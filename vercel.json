{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "microphone=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; frame-src https://www.openstreetmap.org; object-src 'none'; frame-ancestors 'none'; base-uri 'none'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/workecho?route=:path*" },
    { "source": "/intake", "destination": "/index.html" },
    { "source": "/intake/review", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/staff/review", "destination": "/index.html" },
    { "source": "/staff/referrals", "destination": "/index.html" }
  ]
}
