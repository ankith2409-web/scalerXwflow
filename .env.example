# AI is disabled by default. Change only after choosing a provider credential and usage budget.
WORKECHO_AI_ENABLED=0
WORKECHO_AI_PROVIDER=gemini
# Hosted fictional demos need a second explicit opt-in and the durable database quota.
WORKECHO_DEMO_AI_ENABLED=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional server-side text models. Never use a VITE_ prefix for a credential.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Capture uses the genuine Wispr Flow app or Notetaker MCP. No replacement recognizer is required.
# Hosted shared workspace (Neon). Keep these server-side; never use VITE_ prefixes.
DATABASE_URL=
APP_ORIGIN=https://workecho-psi.vercel.app
# 32 random bytes encoded as base64url. Encrypts Wispr OAuth cookies and isolated demo snapshots.
WORKECHO_DEMO_KEY=
# PORT=3002
